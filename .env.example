# 공공데이터포털 일반 인증키(Decoding). 전국주차장정보표준데이터·TourAPI 공용
DATA_GO_KR_KEY=
# 카카오 REST API 키(좌표 없는 주차장 주소 검색)
KAKAO_REST_KEY=
# 주차 비서 LLM: openrouter(:free 모델만) | lab(연구실 서버). 쉼표로 순서를 주면 앞이 실패할 때 다음으로(예: lab,openrouter)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free
# LLM_PROVIDER=lab 일 때
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_DISABLE_THINKING=1
LLM_TIMEOUT=45
# 채팅 분당 요청 제한(전체, 사용자별)
CHAT_RATE_PER_MIN=20
CHAT_RATE_PER_CLIENT=6

# 점주 키 발급·피드백 조회용 관리자 키(서버 전용, 프론트에 넣지 말 것)
ADMIN_API_KEY=
